    given-names: Igor
    orcid: "https://orcid.org/0009-0006-8636-1377"
date-released: 2026-11-16
version: "1.0.0"
license: CC-BY-4.0
url: "https://page2ai.net/research/agent-fetch-outcomes/"
repository: "https://github.com/igorsaevets/agent-fetch-outcomes"
keywords:
  - AI agents
  - coding agents
  - web fetch
  - HTTP status
  - Claude Code
  - Codex
  - open data
